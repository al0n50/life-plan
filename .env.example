# Optional. The app already points at the Life Plan Supabase project; set these only to use
# another one (for example a local Supabase for development). Copy to .env.local.
# Both values are public by design (row-level security protects each account's plan).
# Never put a database password or secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
